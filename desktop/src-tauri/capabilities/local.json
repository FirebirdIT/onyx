{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local",
  "description": "Grants the bundled Deep X pages (setup, settings, backup) the engine, Deep X Route and backup commands. Remote pages do not get this capability.",
  "windows": ["*"],
  "local": true,
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "allow-get-server-url",
    "allow-get-bootstrap-state",
    "allow-set-server-url",
    "allow-get-config-path-cmd",
    "allow-check-server-reachable",
    "allow-open-in-browser",
    "allow-open-config-file",
    "allow-open-config-directory",
    "allow-navigate-to",
    "allow-reload-page",
    "allow-go-back",
    "allow-go-forward",
    "allow-new-window",
    "allow-reset-config",
    "allow-engine-status",
    "allow-engine-start",
    "allow-engine-stop",
    "allow-engine-restart",
    "allow-engine-set-stop-on-quit",
    "allow-use-local-engine",
    "allow-complete-setup",
    "allow-route-key-status",
    "allow-route-save-key",
    "allow-route-forget-key",
    "allow-route-sign-in",
    "allow-route-sign-in-cancel",
    "allow-backup-now",
    "allow-backup-restore"
  ]
}

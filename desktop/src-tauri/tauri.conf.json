{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Deep X",
  "version": "0.0.0-dev",
  "identifier": "com.deepx.desktop",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Deep X",
        "label": "main",
        "url": "index.html",
        "create": false,
        "width": 1232,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "backgroundColor": "#1a1a2e",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "tabbingIdentifier": "deepx"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Deep X desktop app",
    "longDescription": "Deep X runs its engine on this computer and opens it in a native window. It does not need Docker.",
    "macOS": {
      "entitlements": null,
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "publisher": "Deep X",
    "copyright": "Copyright Deep X. MIT licence.",
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFNDA4NzUwNUZCMDYwQTIKUldTaVlMQmZVSWRBVHZBdC9Nb0R1TVZMK2x4QVR5aUJ1OTRHM3hVbk5jRjgvcnBLMjlFQTdaVHQK",
      "endpoints": [
        "https://deepx-hub.vercel.app/api/desktop/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
